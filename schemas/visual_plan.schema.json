{
  "$defs": {
    "CoverSpec": {
      "additionalProperties": false,
      "properties": {
        "style": {
          "default": "editorial",
          "title": "Style",
          "type": "string"
        },
        "ratio": {
          "default": "2.35:1",
          "title": "Ratio",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        },
        "asset_path": {
          "default": "",
          "title": "Asset Path",
          "type": "string"
        }
      },
      "title": "CoverSpec",
      "type": "object"
    },
    "DiagramSpec": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "type": {
          "default": "flowchart",
          "title": "Type",
          "type": "string"
        },
        "spec": {
          "default": "",
          "title": "Spec",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "DiagramSpec",
      "type": "object"
    },
    "ImageSpec": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "description": "Insert before the section/block at this 1-based position (headings when present, top-level blocks otherwise).",
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "purpose": {
          "default": "concept",
          "title": "Purpose",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        },
        "asset_path": {
          "default": "",
          "title": "Asset Path",
          "type": "string"
        }
      },
      "required": [
        "position"
      ],
      "title": "ImageSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "description": "Artifact creation timestamp (UTC).",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cover": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "images": {
      "items": {
        "$ref": "#/$defs/ImageSpec"
      },
      "title": "Images",
      "type": "array"
    },
    "diagrams": {
      "items": {
        "$ref": "#/$defs/DiagramSpec"
      },
      "title": "Diagrams",
      "type": "array"
    },
    "degraded": {
      "default": false,
      "description": "True only when prompt planning itself failed and deterministic fallback prompts were used (prompt-first: placeholder figure blocks are the primary product, not a degraded exit).",
      "title": "Degraded",
      "type": "boolean"
    }
  },
  "title": "VisualPlan",
  "type": "object"
}