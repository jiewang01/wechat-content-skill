{
  "$defs": {
    "Attack": {
      "additionalProperties": false,
      "properties": {
        "attack_id": {
          "title": "Attack Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "location": {
          "description": "Node id, source id or section locator of the attacked spot.",
          "title": "Location",
          "type": "string"
        },
        "evidence": {
          "description": "Verbatim evidence backing the attack (hard constraint H2).",
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "suggestion": {
          "default": "",
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "attack_id",
        "category",
        "location",
        "evidence"
      ],
      "title": "Attack",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "description": "Artifact creation timestamp (UTC).",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "gate": {
      "enum": [
        "content",
        "render",
        "publish"
      ],
      "title": "Gate",
      "type": "string"
    },
    "round": {
      "description": "Adversarial round number, capped at 3 (hard constraint H4).",
      "maximum": 3,
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "attacks": {
      "items": {
        "$ref": "#/$defs/Attack"
      },
      "title": "Attacks",
      "type": "array"
    }
  },
  "required": [
    "gate",
    "round"
  ],
  "title": "AttackReport",
  "type": "object"
}