# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Run outputs (artifacts / checkpoints) — never commit
outputs/*
!outputs/.gitkeep

# Secrets & real account configs — never commit
.env
.env.*
*.secret
accounts/*
!accounts/accounts.example.yaml

# TRAE IDE temp share packages
.trae-html-share-packages/

# OS / editor
.DS_Store
.idea/
.vscode/
